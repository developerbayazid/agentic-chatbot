OPENAI_API_KEY=your_openai_api_key
DATABASE_PATH=data/chatbot_memory.db

# Optional model overrides
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Retrieval-augmented generation
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.15
# Retrieval mode: hybrid (BM25 + FAISS fused with RRF), vector, or bm25
RAG_SEARCH_MODE=hybrid
RAG_VECTOR_CANDIDATES=10
RAG_BM25_CANDIDATES=10
RAG_RRF_K=60
DOCS_PATH=docs
RAG_INDEX_PATH=data/faiss
RAG_MAX_TEXT_BYTES=2000000
RAG_MAX_PDF_BYTES=20000000
RAG_MAX_PDF_PAGES=200

# Inventory / ERP demo dataset (JSON, no database)
INVENTORY_DATA_PATH=inventory-data/inventory/inventory_data.json
# Employee who reviews approvals in this CLI (used in the audit trail)
INVENTORY_OPERATOR_ID=EMP-006
# Keep only the newest N entries in each log
INVENTORY_OPERATION_LOG_LIMIT=500
INVENTORY_AUDIT_LOG_LIMIT=1000

# ==============================
# REST API
# ==============================
API_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_UPLOAD_PATH=data/uploads
API_MAX_UPLOAD_BYTES=20000000

# Operator identities, "name=secret,name=secret". Exchange one for a JWT at
# POST /api/v1/auth/token. Empty means no keys are configured.
API_KEYS=alice=change-me-1,bob=change-me-2

# Signing material. There is no working default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list. Wildcards are rejected when credentials are enabled.
CORS_ORIGINS=http://localhost:3000
