OPENAI_API_KEY=your_openai_api_key

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=agentic-chatbot-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# PostgreSQL is the only storage backend: relational rows, embeddings
# (pgvector), and LangGraph checkpoints all live in this one database.
# Replace every part of this value; the credentials in a connection string are
# real secrets. See POSTGRES.md.
#
# Use 127.0.0.1 when the app runs on the host. `docker compose` overrides this
# with the `db` service address (see docker-compose.yml); do not edit it for the
# compose stack.
POSTGRES_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Read by docker-compose only. It initialises the database container's role and
# is interpolated into the compose-only DSN (postgresql://bayazid:…@db:5432).
# The application itself never reads it — it uses POSTGRES_DSN exclusively.
#
# Use a URL-safe value (letters, digits, `-`, `_`) or percent-encode it, because
# it is embedded in a connection string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me-in-production

# Optional model overrides
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Optional system prompt override. Left empty, the built-in prompt is used.
# SYSTEM_PROMPT=You are a helpful assistant.

# Retrieval-augmented generation
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.15
# Retrieval mode: hybrid (pgvector + BM25 fused with RRF), vector, or bm25
RAG_SEARCH_MODE=hybrid
RAG_VECTOR_CANDIDATES=10
RAG_BM25_CANDIDATES=10
RAG_RRF_K=60
DOCS_PATH=docs
RAG_MAX_TEXT_BYTES=2000000
RAG_MAX_PDF_BYTES=20000000
RAG_MAX_PDF_PAGES=200

# Inventory / ERP demo dataset (JSON, no database)
INVENTORY_DATA_PATH=inventory-data/inventory/inventory_data.json
# Employee who reviews approvals in this CLI (used in the audit trail)
INVENTORY_OPERATOR_ID=EMP-006
# Keep only the newest N entries in each log
INVENTORY_OPERATION_LOG_LIMIT=500
INVENTORY_AUDIT_LOG_LIMIT=1000

# ==============================
# REST API
# ==============================
API_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_UPLOAD_PATH=data/uploads
API_MAX_UPLOAD_BYTES=20000000

# Operator identities, "name=secret,name=secret". Exchange one for a JWT at
# POST /api/v1/auth/token. Empty means no keys are configured.
API_KEYS=alice=change-me-1,bob=change-me-2

# Signing material. There is no working default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list. Wildcards are rejected when credentials are enabled.
CORS_ORIGINS=http://localhost:3000
