# ---------------------------------------------------------------------------
# BAYAZID AI — frontend environment
#
# Everything here is SERVER-SIDE ONLY. None of it is a NEXT_PUBLIC_ variable,
# because the browser must never receive the backend credential: sign-in
# happens in a Route Handler and the JWT stays in an HttpOnly cookie.
# ---------------------------------------------------------------------------

# Where FastAPI listens. Server-only; the browser never calls it directly.
#
# Local development: http://127.0.0.1:8000
# Docker Compose:    http://backend:8000   (the service name on the compose network)
BACKEND_API_URL=http://127.0.0.1:8000

# Whether the session cookie is marked `Secure`.
#
# Defaults to true when NODE_ENV=production. Leave it unset for HTTPS. Set it to
# false ONLY for a deliberate plain-HTTP deployment (e.g. a VM without TLS),
# because a browser will not send a Secure cookie over http:// and the session
# would silently never authenticate.
# SESSION_COOKIE_SECURE=false
